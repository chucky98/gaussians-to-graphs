---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { mdxComponents } from '../../components/content';
import { visiblePosts, type Post } from '../../lib/site/posts';
import { readingMinutes } from '../../lib/site/reading-time';

export async function getStaticPaths() {
  const posts = await visiblePosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingMinutes(post.body ?? '');
---

<PostLayout post={post} headings={headings} minutes={minutes}>
  <Content components={mdxComponents} />
</PostLayout>
