---
import BaseLayout from '../layouts/BaseLayout.astro';
import { repoUrl, siteConfig, statsEnabled } from '../lib/site/config';
import { url, postPath } from '../lib/site/url';
import { counterUrl } from '../lib/site/stats';
import { visiblePosts } from '../lib/site/posts';

const stats = statsEnabled();
const code = siteConfig.stats.goatcounterCode;
const posts = stats ? (await visiblePosts()).filter((p) => p.data.status === 'published') : [];
const counters = stats
  ? {
      total: counterUrl(code, 'TOTAL'),
      posts: posts.map((p) => ({
        number: p.data.number,
        title: p.data.title,
        href: url(postPath(p.id)),
        counter: counterUrl(code, url(postPath(p.id))),
      })),
    }
  : null;
---

<BaseLayout title="About" description="What this site is, who it is for, and how it is built.">
  <div class="prose page" data-pagefind-body>
    <h1>About</h1>
    <h2>What this is</h2>
    <p>
      {siteConfig.title} is a free series of posts on state estimation. It starts with a single Gaussian and works up to
      the sparse optimization problems at the heart of modern SLAM (simultaneous localization and mapping). Along the
      way it covers least squares, the Kalman filter and its nonlinear relatives, particle filters, rotations and Lie
      groups, factor graphs and pose-graph optimization.
    </p>
    <p>
      Each post pairs a written explanation with interactive figures that run in your browser. You can drag a covariance
      ellipse, tune a filter’s noise model or break an optimizer and see what happens. Nothing is a pre-recorded video.
    </p>
    <h2>Who it is for</h2>
    <p>
      Engineering students, robotics and autonomy engineers, and anyone learning on their own. The series assumes
      undergraduate calculus, basic linear algebra (matrix multiplication, inverses, eigenvalues) and basic probability.
      Everything else is introduced as it is needed. The <a href={`${url('')}#syllabus`}>syllabus</a> lists the posts in
      order.
    </p>
    <h2>How it is built</h2>
    <p>
      The site is static, built with Astro and hosted on GitHub Pages. The interactive figures are Svelte components;
      the mathematics behind them lives in a small, unit-tested TypeScript library, so the numbers you see in a figure
      come from the same code that the tests check. Equations are typeset with KaTeX.
    </p>
    <p>
      The code and the text are written with Claude Code, Anthropic’s AI coding assistant, under the direction and
      review of the site’s owner. Every post goes through automated checks before it is published: unit tests for the
      mathematics, including identities such as “recursive least squares equals batch least squares”, a script that
      checks each claim the text makes about a figure against that figure’s default settings, and browser tests on phone
      and desktop widths. If you find an error, please <a href={`${repoUrl}/issues/new`}>open an issue</a>.
    </p>
    <h2>Licenses</h2>
    <p>
      Text and figures are licensed under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. The code
      is under the <a href={`${repoUrl}/blob/main/LICENSE`}>MIT license</a>. The source is on
      <a href={repoUrl}>GitHub</a>.
    </p>
    <h2>Privacy</h2>
    {stats ? (
      <p>
        The site sets no cookies. It counts page views with <a href="https://www.goatcounter.com">GoatCounter</a>, which
        stores no personal data and does not track you across sites; the totals are public, below. Your theme choice is
        stored only in your own browser.
      </p>
    ) : (
      <p>The site sets no cookies and uses no analytics. Your theme choice is stored only in your own browser.</p>
    )}
    {counters && (
      <section
        class="stats ui"
        id="site-statistics"
        aria-labelledby="stats-title"
        data-counters={JSON.stringify(counters)}
      >
        <h2 id="stats-title">Site statistics</h2>
        <p class="total">
          Page views so far: <strong data-stats-total>…</strong>
        </p>
        <table>
          <caption class="visually-hidden">Page views per post</caption>
          <thead>
            <tr>
              <th scope="col">Post</th>
              <th scope="col" class="num">
                Views
              </th>
            </tr>
          </thead>
          <tbody data-stats-rows>
            {counters.posts.map((p) => (
              <tr data-counter={p.counter}>
                <td>
                  <a href={p.href}>
                    {p.number}. {p.title}
                  </a>
                </td>
                <td class="num" data-views>
                  …
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="note" data-stats-note>
          Counted by GoatCounter since statistics were switched on; reloads and bots may be included.
        </p>
      </section>
    )}
  </div>
</BaseLayout>

<script>
  // Fill in the public counters. Any failure leaves the section readable and says so.
  import { parseCount as parse } from '../lib/site/stats';

  const section = document.querySelector<HTMLElement>('#site-statistics');
  if (section) {
    const get = async (href: string): Promise<number | null> => {
      try {
        const res = await fetch(href, { mode: 'cors' });
        if (res.status === 404) return 0; // GoatCounter answers 404 for pages without views yet
        if (!res.ok) return null;
        return parse(((await res.json()) as { count?: unknown }).count);
      } catch {
        return null;
      }
    };
    const fmt = (n: number | null) => (n === null ? '—' : n.toLocaleString('en-GB'));
    const { total } = JSON.parse(section.dataset.counters!) as { total: string };
    void get(total).then((n) => {
      section.querySelector('[data-stats-total]')!.textContent = fmt(n);
      if (n === null)
        section.querySelector('[data-stats-note]')!.textContent = 'The statistics could not be loaded right now.';
    });
    const body = section.querySelector<HTMLElement>('[data-stats-rows]')!;
    const rows = Array.from(body.querySelectorAll<HTMLTableRowElement>('tr[data-counter]'));
    void Promise.all(
      rows.map(async (row) => {
        const n = await get(row.dataset.counter!);
        row.querySelector('[data-views]')!.textContent = fmt(n);
        return { row, n: n ?? -1 };
      }),
    ).then((list) => {
      list.sort((a, b) => b.n - a.n);
      for (const { row } of list) body.append(row); // most read first
    });
  }
</script>

<style>
  .stats {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--c-border);
    font-size: var(--fs-small);
    color: var(--c-muted);
  }
  .stats h2 {
    font-size: 1.05rem;
    color: var(--c-fg);
  }
  .stats .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .stats .note {
    font-size: 0.8rem;
  }
  .page {
    padding: var(--space-5) var(--gutter);
    max-width: calc(var(--w-text) + 2 * var(--gutter));
  }
</style>
