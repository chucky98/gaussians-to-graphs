---
import { giscusEnabled, siteConfig } from '../../lib/site/config';
const g = siteConfig.giscus;
const enabled = giscusEnabled();
---

{enabled && (
  <section class="comments" aria-label="Comments">
    <h2>Comments</h2>
    <div
      class="giscus-mount"
      data-repo={`${siteConfig.owner}/${siteConfig.repo}`}
      data-repo-id={g.repoId}
      data-category={g.category}
      data-category-id={g.categoryId}
    />
  </section>
)}

<script>
  // Load giscus lazily when the comments section scrolls near the viewport.
  const mount = document.querySelector<HTMLElement>('.giscus-mount');
  if (mount) {
    const theme = (): string => {
      const forced = document.documentElement.getAttribute('data-theme');
      if (forced === 'light' || forced === 'dark') return forced;
      return 'preferred_color_scheme';
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const s = document.createElement('script');
        s.src = 'https://giscus.app/client.js';
        s.async = true;
        s.crossOrigin = 'anonymous';
        const attrs: Record<string, string> = {
          'data-repo': mount.dataset.repo!,
          'data-repo-id': mount.dataset.repoId!,
          'data-category': mount.dataset.category!,
          'data-category-id': mount.dataset.categoryId!,
          'data-mapping': 'pathname',
          'data-strict': '1',
          'data-reactions-enabled': '1',
          'data-emit-metadata': '0',
          'data-input-position': 'top',
          'data-theme': theme(),
          'data-lang': 'en',
          'data-loading': 'lazy',
        };
        for (const [k, v] of Object.entries(attrs)) s.setAttribute(k, v);
        mount.append(s);
      },
      { rootMargin: '400px' },
    );
    io.observe(mount);
  }
</script>

<style>
  .comments {
    margin-top: var(--space-6);
  }
</style>
