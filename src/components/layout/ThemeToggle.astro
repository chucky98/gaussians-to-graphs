---
/** Cycles System → Light → Dark. Stored in localStorage (guarded by try/catch). */
---

<button type="button" class="theme-toggle ui" data-theme-toggle aria-label="Color theme: system">
  <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
    <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path>
  </svg>
  <span data-theme-label>System</span>
</button>

<script>
  type Mode = 'system' | 'light' | 'dark';
  const order: Mode[] = ['system', 'light', 'dark'];
  const names: Record<Mode, string> = { system: 'System', light: 'Light', dark: 'Dark' };

  function read(): Mode {
    try {
      const t = localStorage.getItem('theme');
      return t === 'light' || t === 'dark' ? t : 'system';
    } catch {
      return 'system';
    }
  }

  function apply(mode: Mode): void {
    const root = document.documentElement;
    if (mode === 'system') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', mode);
    try {
      if (mode === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', mode);
    } catch {
      /* storage unavailable: theme still applies for this page */
    }
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      btn.setAttribute('aria-label', `Color theme: ${names[mode].toLowerCase()}. Click to change.`);
      const label = btn.querySelector('[data-theme-label]');
      if (label) label.textContent = names[mode];
    }
  }

  apply(read());
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    btn.addEventListener('click', () => {
      const next = order[(order.indexOf(read()) + 1) % order.length]!;
      apply(next);
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: 1px solid var(--c-border);
    color: var(--c-fg);
    border-radius: var(--radius);
    padding: 0.3rem 0.55rem;
    font-size: var(--fs-ui);
    cursor: pointer;
    min-height: 36px;
  }
  .theme-toggle:hover {
    background: var(--c-surface);
  }
</style>
