---
interface Props {
  title: string;
  /** Repo-relative path of the implementation, linked on GitHub. */
  source?: string;
}
import { sourceUrl } from '../../lib/site/config';
const { title, source } = Astro.props;
---

<figure class="algorithm">
  <figcaption class="ui">
    <span class="kind">Algorithm</span> {title}
  </figcaption>
  <div class="body">
    <slot />
  </div>
  {source && (
    <p class="src ui">
      Implementation: <a href={sourceUrl(source)}>{source}</a>
    </p>
  )}
</figure>

<style>
  .algorithm {
    margin: var(--space-5) 0;
    border-top: 2px solid var(--c-fg);
    border-bottom: 2px solid var(--c-fg);
    padding: 0 0 var(--space-2);
  }
  figcaption {
    font-weight: 600;
    font-size: 0.92rem;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--c-border);
    margin-bottom: var(--space-2);
  }
  .kind {
    color: var(--c-muted);
    margin-right: 0.3em;
  }
  .body :global(ol) {
    font-size: 0.95em;
    margin-bottom: var(--space-2);
  }
  .src {
    font-size: 0.8rem;
    color: var(--c-muted);
    margin: 0;
  }
</style>
