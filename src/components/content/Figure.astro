---
interface Props {
  caption: string;
  wide?: boolean;
}
const { caption, wide = false } = Astro.props;
---

<figure class:list={['figure', { wide }]}>
  <div class="art">
    <slot />
  </div>
  <figcaption class="ui">{caption}</figcaption>
</figure>

<style>
  .figure {
    /* Block margins only, so a wide figure keeps the centring side margins of the global .wide rule. */
    margin-block: var(--space-5);
  }
  .art {
    display: flex;
    justify-content: center;
    overflow-x: auto;
  }
  .art :global(svg) {
    height: auto;
  }
  figcaption {
    font-size: var(--fs-small);
    color: var(--c-muted);
    margin-top: var(--space-2);
    line-height: 1.45;
  }
</style>
